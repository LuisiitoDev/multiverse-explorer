{
  "mcpServers": {
    "github":{
      "type": "http",
       "url": "https://api.githubcopilot.com/mcp/"
    },
    "github-agentic-workflows": {
      "type": "local",
      "command": "gh",
      "args": [
        "aw",
        "mcp-server",
        "--allow-write-tools"
      ],
      "tools": [
        "compile",
        "audit",
        "logs",
        "inspect",
        "status",
        "audit-diff",
        "work-queue",
        "health"
      ]
    }
  }
}
