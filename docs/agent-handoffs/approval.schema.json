{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string"
    },
    "approved_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time the trusted gate verified the native environment review; GitHub does not return a review timestamp."
    },
    "workflow_run_id": {
      "type": "integer",
      "minimum": 1
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "environment_name": {
      "const": "implementation-approval"
    },
    "environment_id": {
      "type": "integer",
      "minimum": 1
    },
    "comments_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "issue_number",
    "pr_number",
    "actor",
    "statement",
    "approved_head_sha",
    "spec_sha256",
    "plan_sha256",
    "base_commit",
    "approved_at",
    "workflow_run_id",
    "run_attempt",
    "environment_name",
    "environment_id",
    "comments_sha256"
  ]
}
