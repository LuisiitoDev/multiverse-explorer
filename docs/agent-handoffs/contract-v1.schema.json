{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LuisiitoDev/multiverse-explorer/docs/agent-handoffs/contract-v1.schema.json",
  "title": "Multiverse Explorer agent handoff v1",
  "type": "object",
  "required": [
    "contract_version",
    "handoff_id",
    "issue",
    "source",
    "target",
    "status",
    "context",
    "scope",
    "evidence",
    "next_action"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^issue-[0-9]+-[a-z-]+-[0-9]+$"
    },
    "issue": {
      "type": "object",
      "required": [
        "number",
        "url",
        "snapshot_sha256"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github.com/LuisiitoDev/multiverse-explorer/issues/[0-9]+$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "enum": [
        "human",
        "planner",
        "implementer",
        "reviewer"
      ]
    },
    "target": {
      "enum": [
        "human",
        "planner",
        "implementer",
        "reviewer"
      ]
    },
    "status": {
      "enum": [
        "PLANNED",
        "APPROVED",
        "IMPLEMENTED",
        "REVIEWED",
        "BLOCKED",
        "ESCALATED"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "requirements",
        "repository",
        "rules",
        "results"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repository": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "base_sha",
        "allowed_paths",
        "denied_paths"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "denied_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "statement": {
          "const": "I approve this exact plan and scope for implementation."
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "issue",
              "file",
              "commit",
              "pr",
              "ci",
              "test",
              "finding"
            ]
          },
          "ref": {
            "type": "string"
          },
          "observed": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "review_decision": {
      "enum": [
        "APPROVE",
        "APPROVE_WITH_COMMENTS",
        "REQUEST_CHANGES",
        "BLOCKED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
